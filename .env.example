# Required Discord application settings
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Public hostname used by Caddy in production (for example astra.example.com).
APP_DOMAIN=localhost

# Use a long, random value in every environment.
SESSION_SECRET=

# Base64-encoded 32-byte key used only for ticket transcript encryption.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Comma-separated former keys accepted only for decryption during rotation.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Optional runtime settings
PORT=3000
DEVELOPER_DISCORD_IDS=
METRICS_TOKEN=

# SQLite database file location (defaults to data/astra.db).
ASTRA_DB_PATH=data/astra.db

# Encrypted SQLite backups. Use a separate key from DATA_ENCRYPTION_KEY.
BACKUP_ENABLED=false
BACKUP_DIRECTORY=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_KEY=
# Comma-separated former backup keys accepted only for restore during rotation.
BACKUP_ENCRYPTION_PREVIOUS_KEYS=

# Optional S3-compatible off-site backup export. Set the complete group or none.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true

# Optional AI providers; only the selected provider needs a key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
# Required for custom providers: exact comma-separated hosts, including ports.
# Example: AI_CUSTOM_ALLOWED_HOSTS=ai.example.com,ai-backup.example.com:8443
AI_CUSTOM_ALLOWED_HOSTS=
AI_API_KEY=
